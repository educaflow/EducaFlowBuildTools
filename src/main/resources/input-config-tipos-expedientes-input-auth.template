<auth>

    <permission name="{{tipoExpediente.code}}.all" object="{{tipoExpediente.fqcnExpediente}}">
        <can create="true" read="true" write="true" remove="true" export="true"/>
    </permission>

    <group code="admins">
        <permission name="{{tipoExpediente.code}}.all"/>
    </group>

    <group code="users">
        <permission name="{{tipoExpediente.code}}.all"/>
    </group>

</auth>
