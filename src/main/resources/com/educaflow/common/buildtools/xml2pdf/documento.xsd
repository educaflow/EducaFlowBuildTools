<?xml version="1.0" encoding="UTF-8"?>
<!-- Esquema del XML de definición de los documentos PDF de los trámites de la
     secretaría virtual: los documentos (raíz <documento>) y los fragmentos
     reutilizables _*.xml (raíz <fragmento>) que aquellos incluyen con
     <include href="..."/>. Xml2Pdf valida cada fichero contra este esquema al
     cargarlo, y también el documento resultante de expandir los includes.
     El formato está documentado en el skill k-documentos de secretaria-virtual. -->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" elementFormDefault="qualified">

    <!-- colspan: número de columnas de la rejilla de 12; positivo, admite decimales. -->
    <xs:simpleType name="colspanType">
        <xs:restriction base="xs:decimal">
            <xs:minExclusive value="0"/>
        </xs:restriction>
    </xs:simpleType>

    <!-- rowSpan: multiplicador de alto de fila; >= 1, admite decimales. -->
    <xs:simpleType name="rowSpanType">
        <xs:restriction base="xs:decimal">
            <xs:minInclusive value="1"/>
        </xs:restriction>
    </xs:simpleType>

    <!-- nombreCampo: expresión literal no vacía (self.x, String.valueOf(...), true, ...). -->
    <xs:simpleType name="nombreCampoType">
        <xs:restriction base="xs:string">
            <xs:minLength value="1"/>
        </xs:restriction>
    </xs:simpleType>

    <!-- Textos bilingües como elementos hijos. Admiten campos inline
         ${nombre;n}. Un <castellano> omitido o vacío omite el castellano. Un
         <valenciano> OMITIDO se calcula traduciendo el <castellano> con el
         traductor externo (apertium); para que un texto no lleve valenciano
         hay que poner el <valenciano> vacío. -->
    <xs:group name="textosBilingues">
        <xs:sequence>
            <xs:element name="valenciano" type="xs:string" minOccurs="0"/>
            <xs:element name="castellano" type="xs:string" minOccurs="0"/>
        </xs:sequence>
    </xs:group>

    <xs:complexType name="campoType">
        <xs:group ref="textosBilingues"/>
        <xs:attribute name="nombreCampo" type="nombreCampoType" use="required"/>
        <xs:attribute name="colspan" type="colspanType" use="required"/>
        <xs:attribute name="rowSpan" type="rowSpanType"/>
    </xs:complexType>

    <xs:complexType name="textoType">
        <xs:group ref="textosBilingues"/>
        <xs:attribute name="colspan" type="colspanType" use="required"/>
        <xs:attribute name="rowSpan" type="rowSpanType"/>
    </xs:complexType>

    <!-- href de un <include>: ruta relativa a un fragmento cuyo nombre de
         fichero empieza por "_" (convención de fragmentos). -->
    <xs:simpleType name="hrefFragmentoType">
        <xs:restriction base="xs:string">
            <xs:pattern value="([^/]+/)*_[^/]+\.xml"/>
        </xs:restriction>
    </xs:simpleType>

    <!-- Contenido común de <documento> y <fragmento>: como máximo un <titulo>
         (siempre primero) seguido de secciones e includes de fragmentos en
         cualquier orden. Los <include> solo pueden aparecer a este nivel,
         nunca dentro de una <seccion>. Como el documento expandido también se
         valida, un título duplicado que venga de un fragmento da ERROR. -->
    <xs:complexType name="contenidoDocumentoType">
        <xs:sequence>

            <xs:element name="titulo" minOccurs="0">
                <xs:complexType>
                    <xs:group ref="textosBilingues"/>
                </xs:complexType>
            </xs:element>

            <xs:choice minOccurs="0" maxOccurs="unbounded">

            <xs:element name="seccion">
                <xs:complexType>
                    <xs:sequence>
                        <xs:group ref="textosBilingues"/>
                        <xs:element name="fila" minOccurs="0" maxOccurs="unbounded">
                            <xs:complexType>
                                <xs:choice minOccurs="1" maxOccurs="unbounded">
                                    <xs:element name="campo" type="campoType"/>
                                    <xs:element name="check" type="campoType"/>
                                    <xs:element name="texto" type="textoType"/>
                                </xs:choice>
                            </xs:complexType>
                        </xs:element>
                    </xs:sequence>
                </xs:complexType>
            </xs:element>

            <xs:element name="include">
                <xs:complexType>
                    <xs:attribute name="href" type="hrefFragmentoType" use="required"/>
                </xs:complexType>
            </xs:element>

            </xs:choice>

        </xs:sequence>
    </xs:complexType>

    <xs:element name="documento" type="contenidoDocumentoType"/>

    <!-- Raíz de los fragmentos _*.xml. Xml2Pdf sustituye cada <include> por
         los hijos de esta raíz, recursivamente si el fragmento tiene a su vez
         otros <include>. -->
    <xs:element name="fragmento" type="contenidoDocumentoType"/>

</xs:schema>